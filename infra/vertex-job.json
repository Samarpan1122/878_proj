{
  "displayName": "geocrash-safety-candidate",
  "jobSpec": {
    "serviceAccount": "geocrash-jobs@YOUR_PROJECT.iam.gserviceaccount.com",
    "workerPoolSpecs": [{
      "machineSpec": {"machineType": "n1-standard-4"},
      "replicaCount": "1",
      "containerSpec": {
        "imageUri": "us-central1-docker.pkg.dev/YOUR_PROJECT/geocrash/safety:YOUR_IMAGE_TAG",
        "command": ["python"],
        "args": ["-m", "safety.cloud_job", "--bucket", "YOUR_BUCKET", "--task", "candidate"]
      }
    }]
  }
}
