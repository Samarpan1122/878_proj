# Safety artifacts; never point this at the legacy data/processed directory.
GEOCRASH_SAFETY_DATA=data/safety

# Optional local research browser Maps key. Restrict it to your actual referrers.
GOOGLE_MAPS_API_KEY=

# Optional PostGIS. Use a deployment secret rather than storing a real URL here.
DATABASE_URL=

# Set an operational contact before scheduling NOAA requests for an agency.
NWS_USER_AGENT=GeoCrashAI pilot

# Optional path to an authorized GeoJSON incident-feed agreement/configuration.
INCIDENT_FEED_CONFIG=
# Optional operator-owned OSRM provider. The public OSRM demo is not a commercial backend.
SAFETY_ROUTING_OSRM_URL=
# Set to the private Cloud Run service URL to use service-account identity tokens.
SAFETY_ROUTING_AUTH_AUDIENCE=
